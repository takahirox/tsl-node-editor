{
  "name": "tsl-node-editor",
  "version": "0.1.0",
  "description": "Node-based editor for building Three.js TSL materials with WebGPU preview and export.",
  "type": "module",
  "license": "MIT",
  "author": "Takahiro",
  "repository": {
    "type": "git",
    "url": "https://github.com/takahirox/tsl-node-editor.git"
  },
  "homepage": "https://github.com/takahirox/tsl-node-editor",
  "bugs": {
    "url": "https://github.com/takahirox/tsl-node-editor/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:tsl": "node scripts/check-tsl-publication.mjs && node scripts/check-tsl-roundtrip.mjs",
    "check:tsl:browser": "node scripts/check-tsl-browser.mjs",
    "check:workspace:browser": "node scripts/check-workspace-browser.mjs"
  },
  "dependencies": {
    "@takahirox/gltf-three-materials-tsl-exporter": "0.4.1",
    "@takahirox/gltf-three-materials-tsl-loader": "0.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
